VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Public base URL of the deployed app (no trailing slash). Used by the
# OPERATOR-ONLY script scripts/platform-owner-bootstrap.mjs to build the
# Platform Owner's one-time activation link target: <base>/platform/set-password
# Precedence: --redirect-base=<url>  >  KOLBOX_APP_BASE_URL  >
# SESSION_ALLOWED_ORIGIN  >  built-in default (production origin for the
# approved Production project, http://localhost:5173 otherwise).
# The script reads .env.local (not .env) and the real process environment, so
# put this in .env.local, export it in the shell, or pass --redirect-base.
# The primary link the script emits is <base>/platform/set-password with a
# token_hash query parameter, redeemed by the app itself - it needs no Supabase
# dashboard configuration. NOTE: the secondary (fallback) Supabase action link
# additionally requires this URL to be listed in the project's Auth -> URL
# Configuration -> Redirect URLs allow-list, or GoTrue silently discards it and
# falls back to the project Site URL.
KOLBOX_APP_BASE_URL=https://your-app.vercel.app
