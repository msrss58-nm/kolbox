{
  "outputDirectory": "dist",
  "crons": [
    {
      "path": "/api/budget/actions",
      "schedule": "0 3 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'none'" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/election-day/permission-users-delete",
      "destination": "/api/election-day/permission-users?__pu_action=delete"
    },
    {
      "source": "/api/election-day/permission-users-reset-password",
      "destination": "/api/election-day/permission-users?__pu_action=reset-password"
    },
    {
      "source": "/api/election-day/coordinator-allocation",
      "destination": "/api/election-day/actions"
    },
    {
      "source": "/api/election-day/clear-voters",
      "destination": "/api/election-day/import-voters?__vf_op=clear"
    },
    {
      "source": "/api/election-day/owner-coordinator-allocation",
      "destination": "/api/election-day/owner-actions"
    },
    {
      "source": "/api/election-day/owner-session",
      "destination": "/api/election-day/owner-actions?op=session"
    },
    {
      "source": "/api/auth/login",
      "destination": "/api/platform/session?auth_op=login"
    },
    {
      "source": "/api/auth/continue",
      "destination": "/api/platform/session?auth_op=continue"
    },
    {
      "source": "/api/auth/txn",
      "destination": "/api/platform/session?auth_op=txn"
    },
    {
      "source": "/api/auth/complete",
      "destination": "/api/platform/session?auth_op=complete"
    },
    {
      "source": "/api/multi-entity/session",
      "destination": "/api/platform/session?me_op=session"
    },
    {
      "source": "/api/multi-entity/workspace",
      "destination": "/api/platform/session?me_op=workspace"
    },
    {
      "source": "/api/multi-entity/aggregates",
      "destination": "/api/platform/session?me_op=aggregates"
    },
    {
      "source": "/api/multi-entity/workspace-aggregates",
      "destination": "/api/platform/session?me_op=workspace_aggregates"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
